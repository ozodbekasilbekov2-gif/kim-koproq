# Database (SQLite for dev, can be PostgreSQL via DATABASE_URL=postgresql://...)
DATABASE_URL=file:./db/custom.db

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# NextAuth secret (any random string)
NEXTAUTH_SECRET=your-random-secret-here

# Public URL where the app is hosted (used for Telegram webhook + Mini App URL)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_MINI_APP_URL=http://localhost:3000
