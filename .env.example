# === DATABASE ===
# Use PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
# Get a free Postgres at https://neon.tech — sign up, create a project, copy connection string.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# === TELEGRAM BOT ===
# Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# === NEXTAUTH SECRET ===
# Generate one with: openssl rand -base64 32
# Or use any long random string (min 32 characters).
# This is used to sign JWT session tokens — keep it SECRET and NEVER commit it.
# Generate a fresh one for production!
NEXTAUTH_SECRET=run-openssl-rand-base64-32-to-get-a-secret

# === PUBLIC URLS ===
# Set to your deployed URL on Vercel
NEXTAUTH_URL=https://your-app.vercel.app
NEXT_PUBLIC_MINI_APP_URL=https://your-app.vercel.app
