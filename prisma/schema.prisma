// Prisma schema for Kim Ko'proq — multi-user test/survey platform
// Supports: email/password auth, Telegram Mini App auth, question sets,
// avatars (people to vote on), avatar groups, strict/loose question mode, votes.
//
// DATABASE_URL must be a PostgreSQL connection string
// For local dev: use Neon (free) or `docker run -e POSTGRES_PASSWORD=postgres -p 5432 postgres:16`
// For Vercel prod: use Neon, Supabase, Vercel Postgres, etc.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Auth ----------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatarUrl     String?
  // Telegram link (one user may have one TG account, and vice versa)
  telegramId    String?   @unique
  telegramName  String?
  telegramPhoto String?
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  questionSets  QuestionSet[]
  avatars       Avatar[]
  avatarGroups  AvatarGroup[]
  votes         Vote[]
  sessions      Session[]
  accounts      Account[]
  tgBindings    TelegramBinding[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "credentials" | "telegram"
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------- Question Sets ----------------

model QuestionSet {
  id          String     @id @default(cuid())
  title       String
  description String?
  emoji       String     @default("❓")
  // strict: only owner can edit questions
  // loose: any user can edit questions
  mode        String     @default("strict") // "strict" | "loose"
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
  votes       Vote[]
}

model Question {
  id         String       @id @default(cuid())
  text       String
  emoji      String       @default("❓")
  category   String       @default("Xaos")
  setId      String
  set        QuestionSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  deletedBy  String?

  votes      Vote[]
  history    QuestionHistory[]

  @@index([setId])
}

model QuestionHistory {
  id         String    @id @default(cuid())
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  action     String // "add" | "edit" | "delete"
  actor      String
  oldText    String?
  newText    String?
  at         DateTime  @default(now())

  @@index([questionId])
}

// ---------------- Avatars (people to vote on) ----------------

model Avatar {
  id         String   @id @default(cuid())
  name       String
  shortName  String?
  // Either a user-uploaded photo URL, or a professional Lucide icon name
  photoUrl   String?
  iconName   String?
  // Optional group membership (each avatar can be in one group)
  groupId    String?
  group      AvatarGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  votes      Vote[]
  tgBindings TelegramBinding[]

  @@index([groupId])
  @@index([ownerId])
}

model AvatarGroup {
  id        String   @id @default(cuid())
  name      String
  color     String  @default("A") // can be "A" or "B" or arbitrary tag
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  avatars   Avatar[]

  @@index([ownerId])
}

// ---------------- Votes ----------------

model Vote {
  id         String       @id @default(cuid())
  voterId    String
  voter      User         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  setId      String
  set        QuestionSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  targetId   String // avatar id
  target     Avatar       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  groupId    String // group color/tag
  createdAt  DateTime     @default(now())

  @@unique([voterId, questionId, groupId])
  @@index([setId, questionId])
  @@index([voterId])
}

// ---------------- Telegram bot tables ----------------
// Binding: chat_id → user_id + avatar_id (which member the Telegram user is)
model TelegramBinding {
  chatId    String   @id // Telegram chat_id as string
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarId  String?
  avatar    Avatar?  @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  tgName    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
}

// Multi-step conversation state (create/edit question via chat)
model TgSession {
  chatId    String   @id
  state     String
  payload   Json?
  updatedAt DateTime @default(now()) @updatedAt
}

// Registry of native polls sent by the bot: maps Telegram poll_id →
// (question, group, avatar id per option index) so poll_answer updates
// can be written back into the votes table.
model TgPoll {
  pollId           String   @id
  questionId       String
  targetGroup      String
  optionAvatarIds  Json     // array of avatar ids
  chatId           String?
  createdAt        DateTime @default(now())

  @@index([questionId])
}

// Webhook dedupe: Telegram retries deliveries on timeout; this makes
// processing idempotent (fan-outs never duplicate).
model TgUpdate {
  updateId   String   @id
  processedAt DateTime @default(now())
}
